<mxCell id="dw:title" value="&lt;span style=&quot;font-size:20px;color:#1a1a1a;font-weight:bold&quot;&gt;サーバの設定変更：承認されるまで本番は変更しない&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;パターン「工程」のテンプレート。段階ごとに枠で区切り、手順の番号を要素に付ける。承認と変更の線だけを太くする（架空の例）&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=nowrap;spacing=0;fontFamily=BIZ UDPGothic;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DBIZ%2BUDPGothic;" vertex="1" parent="dw:layer"><mxGeometry x="30" y="30" width="683" height="39" as="geometry" /></mxCell>
<mxCell id="before" value="&lt;span style=&quot;font-size:13px;color:#333333;font-weight:bold&quot;&gt;承認前：確認のみ&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;container=1;collapsible=0;recursiveResize=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#bbbbbb;strokeWidth=1;dashed=1;dashPattern=8 4;fixDash=1;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontFamily=BIZ UDPGothic;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DBIZ%2BUDPGothic;" vertex="1" parent="dw:layer"><mxGeometry x="30" y="89" width="164" height="265" as="geometry" /></mxCell>
<mxCell id="s1" value="&lt;span style=&quot;font-size:13px;color:#1a1a1a;font-weight:bold&quot;&gt;① 変更を申請する&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555&quot;&gt;運用担当&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=4;fontFamily=BIZ UDPGothic;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DBIZ%2BUDPGothic;" vertex="1" parent="before"><mxGeometry x="14" y="32" width="136" height="49" as="geometry" /></mxCell>
<mxCell id="s2" value="&lt;span style=&quot;font-size:13px;color:#1a1a1a;font-weight:bold&quot;&gt;② 手順を作成する&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555555&quot;&gt;運用ツール&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.2;align=center;verticalAlign=middle;spacing=4;fontFamily=BIZ UDPGothic;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DBIZ%2BUDPGothic;" vertex="1" parent="before"><mxGeometry x="14" y="117" width="136" height="49" as="geometry" /></mxCell>
